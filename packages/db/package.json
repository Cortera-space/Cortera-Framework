{
  "name": "@tera/db",
  "version": "0.1.0",
  "description": "PostgreSQL database client for Tera - migrations, event storage, actor state, approvals, delayed actions, provenance, and behavioral drift baselines",
  "repository": {
    "type": "git",
    "url": "https://github.com/tera-framework/tera.git",
    "directory": "packages/db"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down"
  },
  "dependencies": {
    "@tera/core": "workspace:*",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}