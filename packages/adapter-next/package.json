{
  "name": "@cortera/adapter-next",
  "version": "0.1.0",
  "description": "Cortera Framework Next.js adapter - exposes Actions as REST endpoints with automatic route generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/cortera-framework/tera.git",
    "directory": "packages/adapter-next"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tera/auth": "workspace:*",
    "@tera/core": "workspace:*"
  },
  "peerDependencies": {
    "next": "^14.0.0"
  }
}