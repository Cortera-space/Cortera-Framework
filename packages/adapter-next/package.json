{
  "name": "@cortera/adapter-next",
  "version": "1.0.0-28",
  "description": "Next.js adapter for Tera - exposes Actions as REST endpoints with automatic route generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/tera-framework/tera.git",
    "directory": "packages/adapter-next"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cortera/auth": "^1.0.0-26",
    "@cortera/core": "^1.0.0-26"
  },
  "peerDependencies": {
    "next": "^14.0.0"
  }
}