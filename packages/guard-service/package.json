{
  "name": "@cortera/guard-service",
  "version": "1.0.0-29",
  "description": "Standalone guard service for Cortera Framework - HTTP API for action execution, approvals, containment review, and observability queries",
  "repository": {
    "type": "git",
    "url": "https://github.com/tera-framework/tera.git",
    "directory": "packages/guard-service"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --tsconfig tsconfig.json --no-dts",
    "dev": "tsup src/index.ts --format esm --watch --tsconfig tsconfig.json --no-dts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cortera/core": "^1.0.0-26",
    "@cortera/db": "^1.0.0-26",
    "fastify": "^4.24.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}