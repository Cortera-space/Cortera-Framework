{
  "name": "@cortera/mcp",
  "version": "1.0.0-28",
  "description": "Model Context Protocol (MCP) server for Tera - exposes Actions as callable tools for AI agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/tera-framework/tera.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@cortera/auth": "^1.0.0-26",
    "@cortera/core": "^1.0.0-26",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.21.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "vitest": "^1.0.0"
  }
}